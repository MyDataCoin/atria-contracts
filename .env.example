# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# ── RPC ───────────────────────────────────────────────────────────────────────
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# ── Verification ──────────────────────────────────────────────────────────────
BSCSCAN_API_KEY=

# ── Deployment signer ─────────────────────────────────────────────────────────
# Prefer a keystore or hardware wallet over a raw key:
#   forge script ... --account atria-deployer      (cast wallet import)
#   forge script ... --ledger --mnemonic-derivation-path "m/44'/60'/0'/0/0"
# DEPLOYER_PRIVATE_KEY is a testnet-only convenience and must stay empty for mainnet.
DEPLOYER_PRIVATE_KEY=
# Address only — used by CheckDeployment to prove the deployer kept no rights.
DEPLOYER_ADDRESS=

# ── Role holders (separate keys — see README, "Роли") ─────────────────────────
# Admin should be a multisig; the deployer renounces admin to it at the end of deployment.
ADMIN_ADDRESS=
MINTER_ADDRESS=
COMPLIANCE_ADDRESS=
PAUSER_ADDRESS=
ORACLE_ADDRESS=
# Backend service key that maintains the allowlist (Tessera EvmAllowlistGateway).
ALLOWLIST_AGENT_ADDRESS=

# ── Token / issue parameters ──────────────────────────────────────────────────
# Значения с пробелами обязательно в кавычках, иначе forge их не прочитает.
TOKEN_NAME="ATRIA Property Test"
TOKEN_SYMBOL=ATRP-T1
# Registered issue size, in whole shares (decimals = 0). Hard cap on total supply.
TOKEN_MAX_SUPPLY=1000000
# The issue this token represents, as the backend reports it:
#   GET /api/v1/properties/{id}/token-contract  ->  propertyIdBytes32
# It is the Property.Id guid, left-aligned in the 32-byte word and zero-padded on the right. Copy it
# from the API rather than converting by hand: the constructor stores it immutably and rejects an
# empty value, so getting it wrong means deploying again. The backend refuses to bind a contract
# whose propertyId is not this issue's.
PROPERTY_ID=

# Existing deployments to reuse instead of deploying fresh ones (optional).
ALLOWLIST_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
